# Hermes Sentinel — copie para .env (o .env nunca vai para o Git)

# Hermes Agent no VPS (API OpenAI-compatível em /v1, autenticada por token estático).
# O token é o API_SERVER_KEY do servidor:  ssh root@<seu-vps> "sed -n 's/^API_SERVER_KEY=//p' /opt/hermes/dashboard.env"
HERMES_GATEWAY_URL=https://<ip-ou-dominio-do-hermes>:8443
HERMES_GATEWAY_TOKEN=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=90

# Alternativa: CLI local do Hermes (~/.hermes). Use "cli" para chamar `hermes chat` em vez do gateway.
HERMES_MODE=gateway
HERMES_LOCAL_CLI_PATH=~/.hermes

# Fallback direto no Gemini Flash se o gateway estiver ocupado/429 (opcional)
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Certificados: bundle do Fedora (contém a CA do servidor Hermes)
SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Kubernetes local
KUBECONFIG_PATH=~/.kube/config
K8S_NAMESPACES=stockflow
K8S_LOG_TAIL_LINES=80

# Obsidian
OBSIDIAN_VAULT_PATH=./obsidian-vault

# GitHub Issues (opcional)
GITHUB_TOKEN=
GITHUB_REPO=MathZiraA/Hermes-Sentinel-AIOps

# Servidor local
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Hermes no VPS ↔ cluster do notebook (túnel SSH reverso + MCP) ---
# Token que o Hermes envia ao MCP local (gere com: openssl rand -hex 32). Vazio = MCP desligado.
SENTINEL_MCP_TOKEN=
SENTINEL_MCP_PORT=8765
# Um token por bot do Hermes: "monitor:tok,supervisor:tok,investigator:tok,executor:tok,itsm:tok"
SENTINEL_MCP_ROLE_TOKENS=
HERMES_AGENT_TIMEOUT_SECONDS=240
